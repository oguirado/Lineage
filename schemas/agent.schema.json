{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "agent",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lineage.agent/v1"
    },
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflow": {
      "enum": [
        "develop",
        "test",
        "review",
        "harden",
        "research",
        "orchestrate"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "allowed_seats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
          },
          "mode": {
            "enum": [
              "headless",
              "interactive"
            ]
          }
        },
        "required": [
          "model",
          "effort",
          "mode"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "gold_s1",
              "memory_v21"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "constitution_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "skill_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "memory_gen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brief_head_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "agent_version": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "born": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "genesis",
            "clone",
            "distill",
            "cross",
            "mutate",
            "specialize"
          ]
        },
        "event_id": {
          "type": "string",
          "minLength": 18,
          "maxLength": 18,
          "pattern": "^e-[0-9a-f]{16}(?![\\s\\S])"
        }
      },
      "required": [
        "op",
        "event_id"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "shadow",
        "promoted",
        "retired"
      ]
    },
    "rule_overrides": {
      "type": "object",
      "description": "A-K0.6: constitution rule overrides applied by agent_mutate/agent_cross; key = GOLD-S1 rule id, value add|remove. Absent means none.",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "enum": [
          "add",
          "remove"
        ]
      },
      "maxProperties": 64
    },
    "promoted_seat": {
      "description": "A-K0.4: seat of the benchmark that promoted this agent; absent unless status is shadow or promoted.",
      "type": "object"
    }
  },
  "required": [
    "schema",
    "agent_id",
    "display_name",
    "workflow",
    "language",
    "allowed_seats",
    "references",
    "constitution_sha256",
    "skills",
    "memory_gen",
    "brief_head_sha256",
    "agent_version",
    "generation",
    "parents",
    "born",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "born": {
            "properties": {
              "op": {
                "const": "genesis"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "parents": {
            "maxItems": 0
          },
          "generation": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "born": {
            "properties": {
              "op": {
                "const": "cross"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "parents": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "born": {
            "properties": {
              "op": {
                "enum": [
                  "clone",
                  "distill",
                  "mutate",
                  "specialize"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "parents": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ]
}
