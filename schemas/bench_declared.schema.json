{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bench_declared.schema.json",
  "title": "bench_declared",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lineage.bench.declared/v1"
    },
    "bench_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
    },
    "bank_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
    },
    "bank_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "protocol": {
      "enum": [
        "paired",
        "crossed"
      ]
    },
    "purpose": {
      "enum": [
        "select",
        "confirm"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
          },
          "mode": {
            "enum": [
              "headless",
              "interactive"
            ]
          }
        },
        "required": [
          "model",
          "effort",
          "mode"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "memory_arms": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "own",
          "inherited"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "credit_rule": {
      "type": "object",
      "properties": {
        "metric": {
          "const": "correctness_first"
        },
        "minimum_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dispersion": {
          "const": "population_stddev"
        },
        "cost_tiebreaker": {
          "type": "boolean"
        }
      },
      "required": [
        "metric",
        "minimum_gain",
        "dispersion",
        "cost_tiebreaker"
      ],
      "additionalProperties": false
    },
    "sprt": {
      "type": "object",
      "properties": {
        "p0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "p1": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "beta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "p0",
        "p1",
        "alpha",
        "beta",
        "cap"
      ],
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "properties": {
        "n_shadow_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "n_shadow_runs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "bench_id",
    "bank_id",
    "bank_sha256",
    "protocol",
    "purpose",
    "agents",
    "seats",
    "memory_arms",
    "credit_rule",
    "sprt",
    "promotion"
  ],
  "additionalProperties": false
}
