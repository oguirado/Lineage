{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "event",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lineage.event/v1"
    },
    "id": {
      "type": "string",
      "minLength": 18,
      "maxLength": 18,
      "pattern": "^e-[0-9a-f]{16}(?![\\s\\S])"
    },
    "lamport": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ledger": {
      "const": "main"
    },
    "agent": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
    },
    "kind": {
      "enum": [
        "reference.pinned",
        "skill.published",
        "skill.retired",
        "agent.born",
        "agent.status",
        "memory.put",
        "memory.retire",
        "run.open",
        "run.beat",
        "run.close",
        "bench.declared",
        "bench.result",
        "bench.verdict"
      ]
    },
    "payload": {},
    "op_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])"
    },
    "request_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "prev_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "required": [
    "schema",
    "id",
    "lamport",
    "ts",
    "ledger",
    "agent",
    "kind",
    "payload",
    "op_id",
    "request_sha256",
    "evidence",
    "prev_sha256",
    "sha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reference.pinned"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "ref_id": {
                "enum": [
                  "gold_s1",
                  "memory_v21"
                ]
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ref_id",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "skill.published"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+(?![\\s\\S])"
                    },
                    "content": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 65536
                    }
                  },
                  "required": [
                    "path",
                    "content"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 256
              }
            },
            "required": [
              "skill_id",
              "sha256",
              "files"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "skill.retired"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "skill_id",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent.born"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "record": {
                "$ref": "agent.schema.json"
              },
              "inherited_units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "$ref": "mem_unit.schema.json"
                    },
                    "source_agent_id": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
                    },
                    "source_unit_id": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                    },
                    "unit_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "unit",
                    "source_agent_id",
                    "source_unit_id",
                    "unit_sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 256
              },
              "rejected_units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent_id": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
                    },
                    "unit_id": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                    },
                    "reason": {
                      "enum": [
                        "episode",
                        "level_one",
                        "level_three",
                        "private",
                        "missing_receipt",
                        "invalid_receipt",
                        "not_promoted",
                        "scope_mismatch",
                        "not_selected",
                        "inactive",
                        "kind_not_inheritable"
                      ]
                    }
                  },
                  "required": [
                    "agent_id",
                    "unit_id",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 10000
              },
              "constitution": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  "overlays": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 64,
                    "uniqueItems": true
                  },
                  "rule_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 256,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "text",
                  "overlays",
                  "rule_ids"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "record",
              "inherited_units",
              "rejected_units",
              "constitution"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent.status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "from": {
                "enum": [
                  "draft",
                  "shadow",
                  "promoted",
                  "retired"
                ]
              },
              "to": {
                "enum": [
                  "draft",
                  "shadow",
                  "promoted",
                  "retired"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "bench_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "seat": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "effort": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
                  },
                  "mode": {
                    "enum": [
                      "headless",
                      "interactive"
                    ]
                  }
                },
                "required": [
                  "model",
                  "effort",
                  "mode"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "agent_id",
              "from",
              "to",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "memory.put"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "unit": {
                "$ref": "mem_unit.schema.json"
              },
              "run_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              }
            },
            "required": [
              "agent_id",
              "unit"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "memory.retire"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "unit_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "superseded_by": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              }
            },
            "required": [
              "agent_id",
              "unit_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.open"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "agent_version": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "seat": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "effort": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
                  },
                  "mode": {
                    "enum": [
                      "headless",
                      "interactive"
                    ]
                  }
                },
                "required": [
                  "model",
                  "effort",
                  "mode"
                ],
                "additionalProperties": false
              },
              "task": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "bank_id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
                  },
                  "bench_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                  },
                  "split": {
                    "enum": [
                      "select",
                      "heldout"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "language"
                ],
                "additionalProperties": false
              },
              "parents_context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent_id": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
                    },
                    "agent_version": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "agent_id",
                    "agent_version",
                    "run_id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 64,
                "uniqueItems": true
              },
              "memory_arm": {
                "enum": [
                  "none",
                  "own",
                  "inherited"
                ]
              }
            },
            "required": [
              "run_id",
              "agent_id",
              "agent_version",
              "seat",
              "task",
              "parents_context",
              "memory_arm"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.beat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "progress": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "run_id",
              "agent_id",
              "progress"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.close"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "record": {
                "$ref": "run.schema.json"
              },
              "memory_receipts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+(?![\\s\\S])"
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 256,
                "uniqueItems": true
              },
              "gate": {
                "type": "object",
                "properties": {
                  "passed": {
                    "const": true
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "passed": {
                          "type": "boolean"
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 2048
                        }
                      },
                      "required": [
                        "id",
                        "passed"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "passed",
                  "checks"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "record",
              "memory_receipts",
              "gate"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bench.declared"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "bench_declared.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bench.result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "bench_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "task_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "agent_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
              },
              "seat": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "effort": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
                  },
                  "mode": {
                    "enum": [
                      "headless",
                      "interactive"
                    ]
                  }
                },
                "required": [
                  "model",
                  "effort",
                  "mode"
                ],
                "additionalProperties": false
              },
              "memory_arm": {
                "enum": [
                  "none",
                  "own",
                  "inherited"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "verdict": {
                "enum": [
                  "ADMIT",
                  "HOLD",
                  "red",
                  "green",
                  "error"
                ]
              },
              "correctness": {
                "enum": [
                  0,
                  1
                ]
              },
              "cost": {
                "type": "object",
                "properties": {
                  "tokens_in": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tokens_out": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tokens_cache": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "duration_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
