{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mem_unit.schema.json",
  "title": "mem_unit",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lineage.mem.unit/v1"
    },
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
    },
    "kind": {
      "enum": [
        "ruling",
        "lesson",
        "negative",
        "workflow",
        "episode",
        "decision",
        "open_item"
      ]
    },
    "level": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "retired"
      ]
    },
    "privacy": {
      "enum": [
        "public",
        "internal",
        "private"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "workflow": {
          "enum": [
            "develop",
            "test",
            "review",
            "harden",
            "research",
            "orchestrate"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "workflow",
        "language"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
        },
        "inherited_from": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
            },
            "unit_id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
            },
            "unit_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "agent_id",
            "unit_id",
            "unit_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "origin",
        "actor"
      ],
      "additionalProperties": false
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
    },
    "body": {}
  },
  "required": [
    "schema",
    "id",
    "kind",
    "level",
    "statement",
    "status",
    "privacy",
    "scope",
    "provenance",
    "receipts",
    "supersedes",
    "body"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ruling"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              1
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "quote_sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "how_to_apply": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "quote_sha256",
              "how_to_apply"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lesson"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2,
              3
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "tempting_use": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "failure_mode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "safer_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "blocked_use": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "minItems": 0,
                "maxItems": 64
              }
            },
            "required": [
              "tempting_use",
              "failure_mode",
              "safer_action",
              "blocked_use"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "negative"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2,
              3
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "gate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "verdict": {
                "enum": [
                  "HOLD",
                  "red",
                  "error"
                ]
              },
              "cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "coordinate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "safer_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "required": [
              "gate_id",
              "verdict",
              "cause",
              "coordinate",
              "safer_action"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "trigger_sig": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "minItems": 1,
                "maxItems": 64
              },
              "stats": {
                "type": "object",
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "successes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mean_reward": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "runs",
                  "successes",
                  "mean_reward"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "candidate",
                  "promoted",
                  "retired"
                ]
              }
            },
            "required": [
              "trigger_sig",
              "steps",
              "stats",
              "status"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "episode"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2,
              3
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "task_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
              },
              "seat": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "effort": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
                  },
                  "mode": {
                    "enum": [
                      "headless",
                      "interactive"
                    ]
                  }
                },
                "required": [
                  "model",
                  "effort",
                  "mode"
                ],
                "additionalProperties": false
              },
              "outcome": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "enum": [
                      "ADMIT",
                      "HOLD",
                      "red",
                      "green",
                      "error"
                    ]
                  },
                  "repair_loops": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "findings": {
                    "type": "object",
                    "properties": {
                      "confirmed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "refuted": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "confirmed",
                      "refuted"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "verdict",
                  "repair_loops",
                  "findings"
                ],
                "additionalProperties": false
              },
              "cost": {
                "type": "object",
                "properties": {
                  "tokens_in": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tokens_out": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tokens_cache": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "duration_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cost_micro_usd": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "tokens_in",
                  "tokens_out",
                  "tokens_cache",
                  "duration_ms",
                  "cost_micro_usd"
                ],
                "additionalProperties": false
              },
              "parents_context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent_id": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9-]{2,63}(?![\\s\\S])"
                    },
                    "agent_version": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]{8,64}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "agent_id",
                    "agent_version",
                    "run_id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 64,
                "uniqueItems": true
              }
            },
            "required": [
              "run_id",
              "task_id",
              "seat",
              "outcome",
              "cost",
              "parents_context"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "open_item"
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "enum": [
              2,
              3
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "class",
              "order"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "receipts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      },
      "else": {
        "not": {
          "required": [
            "superseded_by"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "episode"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "run_id"
            ]
          }
        }
      }
    }
  ]
}
